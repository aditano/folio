# Copy to `.env` for local preview auth. Never commit real secrets.
# If a preview OAuth client secret was ever committed, rotate it in the
# Grok auth broker / provider console before redeploying.

# Shared live-preview OAuth client (*.grok-sandbox.com callbacks)
GROK_PREVIEW_CLIENT_ID=grok_preview
GROK_PREVIEW_CLIENT_SECRET=

# Deployer-injected per-app client (overrides preview values when set)
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Set to "false" for static / GitHub Pages builds (no sign-in)
# VITE_AUTH_ENABLED=false
